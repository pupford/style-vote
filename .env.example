# Password for /results and /api/results. Set this in Vercel → Settings → Environment Variables.
# Use a long random string. Anyone with this key can read every vote.
ADMIN_KEY=

# Injected automatically when you add Upstash Redis from the Vercel Marketplace.
# Leave both blank locally. The app then stores votes in data/votes.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional override for the local file store.
# VOTES_FILE=data/votes.json
